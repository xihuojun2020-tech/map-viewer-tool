{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "小说片段剧情包（首版）",
  "description": "at 是片段阅读顺序；step 是计划展示步骤，均不代表历史日期。基础区域编号引用当前地图包，模型不得生成任意绘图脚本。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "example",
    "baseMap",
    "book",
    "storyDate",
    "chapterHint",
    "sourceNote",
    "coverage",
    "focus",
    "steps",
    "evidence",
    "places",
    "factions",
    "people",
    "units",
    "strengths",
    "observations",
    "controls",
    "actions",
    "agreements",
    "branches",
    "textRevision",
    "locations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "boolean"
    },
    "baseMap": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "jianan-219"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "book": {
      "type": [
        "string",
        "null"
      ]
    },
    "storyDate": {
      "type": [
        "string",
        "null"
      ]
    },
    "chapterHint": {
      "type": "string"
    },
    "sourceNote": {
      "type": "string"
    },
    "coverage": {
      "type": "string"
    },
    "focus": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/coordinates"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quote"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "factions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/faction"
      }
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/strength"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "agreements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agreement"
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/branch"
      }
    },
    "textRevision": {
      "type": "integer",
      "minimum": 1
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "planSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "pointControls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pointControl"
      }
    },
    "readingPositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chapter",
          "paragraph"
        ],
        "additionalProperties": false,
        "properties": {
          "chapter": {
            "type": "integer",
            "minimum": 1
          },
          "paragraph": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "leadership": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "faction",
          "person",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "faction": {
            "$ref": "#/$defs/id"
          },
          "person": {
            "$ref": "#/$defs/id"
          },
          "at": {
            "$ref": "#/$defs/at"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "nullableId": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "at": {
      "type": "integer",
      "minimum": 0
    },
    "coordinates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false
    },
    "status": {
      "enum": [
        "narrated",
        "reported",
        "planned",
        "hypothetical",
        "negated",
        "cancelled"
      ]
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "at",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "mode",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "place",
            "province",
            "region",
            "relative"
          ]
        },
        "baseId": {
          "type": "string"
        },
        "regionIds": {
          "$ref": "#/$defs/ids"
        },
        "between": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "place",
                  "province"
                ]
              }
            }
          },
          "then": {
            "required": [
              "baseId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "region"
              }
            }
          },
          "then": {
            "required": [
              "regionIds"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "relative"
              }
            }
          },
          "then": {
            "required": [
              "between"
            ]
          }
        }
      ]
    },
    "faction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "leader",
        "color",
        "at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "leader": {
          "$ref": "#/$defs/nullableId"
        },
        "color": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "at": {
          "$ref": "#/$defs/at"
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "faction",
        "at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "faction": {
          "$ref": "#/$defs/nullableId"
        },
        "at": {
          "$ref": "#/$defs/at"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "faction",
        "commander",
        "model",
        "at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "faction": {
          "$ref": "#/$defs/id"
        },
        "commander": {
          "$ref": "#/$defs/nullableId"
        },
        "model": {
          "enum": [
            "infantry",
            "archer",
            "cavalry",
            "crossbow",
            "danyang",
            "xianzhen",
            "huangjin"
          ]
        },
        "at": {
          "$ref": "#/$defs/at"
        }
      }
    },
    "strength": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit",
        "value",
        "scope",
        "at",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "evidence": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subjects",
        "at",
        "status",
        "summary",
        "place",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "subjects": {
          "$ref": "#/$defs/ids"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "summary": {
          "type": "string"
        },
        "place": {
          "$ref": "#/$defs/nullableId"
        },
        "evidence": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "faction",
        "regionIds",
        "basis",
        "at",
        "note",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "faction": {
          "$ref": "#/$defs/id"
        },
        "regionIds": {
          "$ref": "#/$defs/ids"
        },
        "basis": {
          "enum": [
            "explicit",
            "inferred"
          ]
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "note": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/ids"
        },
        "revoked": {
          "type": "boolean"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "unit",
        "actor",
        "faction",
        "from",
        "to",
        "status",
        "originBasis",
        "at",
        "step",
        "summary",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/nullableId"
        },
        "actor": {
          "$ref": "#/$defs/nullableId"
        },
        "faction": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/nullableId"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "narrated",
            "planned",
            "negated",
            "cancelled"
          ]
        },
        "originBasis": {
          "enum": [
            "explicit",
            "inferred",
            "unknown"
          ]
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/ids"
        },
        "direction": {
          "enum": [
            "north",
            "south",
            "east",
            "west"
          ]
        }
      }
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "faction",
        "place",
        "regionIds",
        "at",
        "note",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "faction": {
          "$ref": "#/$defs/id"
        },
        "place": {
          "$ref": "#/$defs/id"
        },
        "regionIds": {
          "$ref": "#/$defs/ids"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "note": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/ids"
        },
        "step": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "at",
        "assumption",
        "analysis",
        "focusPlaces",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "assumption": {
          "type": "string",
          "minLength": 1
        },
        "analysis": {
          "type": "string"
        },
        "focusPlaces": {
          "$ref": "#/$defs/ids"
        },
        "evidence": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "person",
        "place",
        "at",
        "note",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "person": {
          "$ref": "#/$defs/id"
        },
        "place": {
          "$ref": "#/$defs/id"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "note": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "pointControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "faction",
        "place",
        "at",
        "note",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "faction": {
          "$ref": "#/$defs/id"
        },
        "place": {
          "$ref": "#/$defs/id"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "note": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/ids"
        },
        "revoked": {
          "type": "boolean"
        }
      }
    }
  }
}
